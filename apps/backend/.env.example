# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT Configuration
JWT_SECRET=biotasys-secret-key-change-in-production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=14d

# Database Configuration (PostgreSQL)
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=1234
DB_NAME=biotasys_database
DB_SCHEMA=public
DB_SYNCHRONIZE=true
DB_MIGRATE_DATA=false
DB_SSL=false
DB_LOG_QUERIES=false
DROP_SCHEMA=false

# Email Service Configuration (Nodemailer/Gmail)
# Para usar Gmail: https://support.google.com/accounts/answer/185833
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu-email@gmail.com
EMAIL_PASSWORD=tu-contraseña-app-especifica
EMAIL_FROM_NAME=Biotasys
EMAIL_SECURE=false

# AI Integration (Python Backend)
# Configurar cuando se integre con el servicio de IA
AI_SERVICE_URL=http://localhost:8000
AI_MAX_RETRIES=5
AI_RETRY_DELAY_MS=30000
AI_REQUEST_TIMEOUT_MS=30000
AI_BACKEND_PUBLIC_URL=http://localhost:3000
AI_SERVICE_API_KEY=your-api-key-here
AI_CALLBACK_API_KEY=mi_clave_local_123
